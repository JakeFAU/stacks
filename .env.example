# Local Compose bootstrap inputs. The passwords are environment-only secrets;
# generate independent values and never commit the populated .env file. The
# port is an environment-only Compose setting, not a file-backed app setting.
STACKS_DB_ADMIN_PASSWORD=
STACKS_DB_APP_PASSWORD=
STACKS_DB_PORT=5432

# These credential-bearing URLs are environment-only. Put the same app password
# used above into this local connection URL.
STACKS_DATABASE_URL=postgres://stacks_app:replace-with-app-password@127.0.0.1:5432/stacks?sslmode=disable
STACKS_MIGRATION_DATABASE_URL=postgres://stacks_admin:replace-with-admin-password@127.0.0.1:5432/stacks?sslmode=disable
# The scopes and role are optional environment overrides for file-eligible
# settings. Core is required; add ",directory" only when enrichment is enabled.
STACKS_DATABASE_SCOPES=core
STACKS_DATABASE_APP_ROLE=stacks_app

# These environment-only integration credentials use the app role for
# repository behavior and the admin role only for temporary test databases.
STACKS_TEST_DATABASE_URL=postgres://stacks_app:replace-with-app-password@127.0.0.1:5432/stacks?sslmode=disable
STACKS_TEST_MIGRATION_DATABASE_URL=postgres://stacks_admin:replace-with-admin-password@127.0.0.1:5432/stacks?sslmode=disable

# Optional environment overrides for file-eligible Google corpus settings and
# installed-application OAuth file paths. Keep both JSON files outside this
# repository; stacks auth google creates the token file. The paths may be in a
# configuration file, but credential contents never may. Personal
# OpenAI/Anthropic acceptance requires a synthetic-only folder.
# To establish source-valid meeting time, name a dated document with exactly
# one leading marker such as: [2026-07-20] Weekly review.
STACKS_GOOGLE_FOLDER_ID=
STACKS_GOOGLE_OAUTH_CLIENT_FILE=/absolute/path/outside/repository/google-oauth-client.json
STACKS_GOOGLE_OAUTH_TOKEN_FILE=/absolute/path/outside/repository/stacks-google-token.json
STACKS_TRANSCRIPT_TITLES=Transcript
STACKS_NOTES_TITLES=Notes

# Optional environment overrides for file-eligible Google Workspace directory
# enrichment. This uses a separate OAuth client/token and never broadens the
# Drive token; credential contents remain outside configuration.
STACKS_GOOGLE_DIRECTORY_ENABLED=false
STACKS_GOOGLE_DIRECTORY_OAUTH_CLIENT_FILE=/absolute/path/outside/repository/google-directory-oauth-client.json
STACKS_GOOGLE_DIRECTORY_OAUTH_TOKEN_FILE=/absolute/path/outside/repository/stacks-google-directory-token.json
STACKS_GOOGLE_DIRECTORY_EMAIL_DOMAINS=corp.example
STACKS_GOOGLE_DIRECTORY_FRESHNESS=24h
STACKS_GOOGLE_DIRECTORY_RETRY_AFTER=15m
STACKS_GOOGLE_DIRECTORY_MAX_ATTEMPTS=3

# Optional environment overrides for file-eligible model policy and selection.
# There are no defaults for data mode, provider, or model ID. Use personal with
# openai/anthropic only for synthetic content; restricted permits only bedrock.
# Direct provider API keys are environment-only and stay in the ignored .env.
STACKS_DATA_MODE=
STACKS_MODEL_PROVIDER=
STACKS_MODEL_ID=
STACKS_MODEL_MAX_OUTPUT_TOKENS=2048
STACKS_MODEL_MAX_ATTEMPTS=5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AWS credentials are environment-only. The profile, region, ingestion bounds,
# and extraction prompt version below are optional environment overrides for
# file-eligible settings. The default credential chain is used when the profile
# is empty.
AWS_BEARER_TOKEN_BEDROCK=
STACKS_AWS_PROFILE=
STACKS_AWS_REGION=
STACKS_INGEST_LEASE_DURATION=5m
STACKS_INGEST_ATTEMPT_TIMEOUT=4m
STACKS_EXTRACTION_PROMPT_VERSION=extract-v2

# Optional environment overrides for file-eligible, provider-free temporal
# query limits. Query execution requires reviewed canonical entity IDs.
STACKS_QUERY_MAX_ENTITIES=16
STACKS_QUERY_MAX_PREDICATES=32
STACKS_QUERY_MAX_CHRONOLOGY=1000

# Optional environment overrides for file-eligible HTTP service settings.
STACKS_HTTP_HOST=127.0.0.1
STACKS_HTTP_PORT=8080
STACKS_READ_HEADER_TIMEOUT_SECONDS=5
STACKS_LOG_LEVEL=info

# Optional environment overrides for file-eligible local OTLP settings.
STACKS_OTEL_ENABLED=false
STACKS_OTEL_ENDPOINT=127.0.0.1:4317
STACKS_OTEL_INSECURE=true
STACKS_OTEL_METRIC_EXPORT_INTERVAL=10s
STACKS_OTEL_SERVICE_NAME=stacks
STACKS_OTEL_TRACE_SAMPLE_RATIO=1
