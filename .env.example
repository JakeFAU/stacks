# Local database bootstrap secrets. Generate independent values; never commit
# the populated .env file.
STACKS_DB_ADMIN_PASSWORD=
STACKS_DB_APP_PASSWORD=
STACKS_DB_PORT=5432

# Put the same app password used above into this local connection URL.
STACKS_DATABASE_URL=postgres://stacks_app:replace-with-app-password@127.0.0.1:5432/stacks?sslmode=disable

# PostgreSQL integration uses the app role for repository behavior and the
# admin role only for isolated forward-migration upgrade schemas.
STACKS_TEST_DATABASE_URL=postgres://stacks_app:replace-with-app-password@127.0.0.1:5432/stacks?sslmode=disable
STACKS_TEST_MIGRATION_DATABASE_URL=postgres://stacks_admin:replace-with-admin-password@127.0.0.1:5432/stacks?sslmode=disable

# Google corpus and installed-application OAuth files. Keep both JSON files
# outside this repository; stacks auth google creates the token file. Personal
# OpenAI/Anthropic acceptance requires a synthetic-only folder with no company
# or other private source content.
# To establish source-valid meeting time, name a dated document with exactly
# one leading marker such as: [2026-07-20] Weekly review.
STACKS_GOOGLE_FOLDER_ID=
STACKS_GOOGLE_OAUTH_CLIENT_FILE=/absolute/path/outside/repository/google-oauth-client.json
STACKS_GOOGLE_OAUTH_TOKEN_FILE=/absolute/path/outside/repository/stacks-google-token.json
STACKS_TRANSCRIPT_TITLES=Transcript
STACKS_NOTES_TITLES=Notes

# Optional Google Workspace directory identity enrichment. This uses a
# separate OAuth client/token and never broadens the Drive token.
STACKS_GOOGLE_DIRECTORY_ENABLED=false
STACKS_GOOGLE_DIRECTORY_OAUTH_CLIENT_FILE=/absolute/path/outside/repository/google-directory-oauth-client.json
STACKS_GOOGLE_DIRECTORY_OAUTH_TOKEN_FILE=/absolute/path/outside/repository/stacks-google-directory-token.json
STACKS_GOOGLE_DIRECTORY_EMAIL_DOMAINS=corp.example
STACKS_GOOGLE_DIRECTORY_FRESHNESS=24h
STACKS_GOOGLE_DIRECTORY_RETRY_AFTER=15m
STACKS_GOOGLE_DIRECTORY_MAX_ATTEMPTS=3

# Model disclosure policy and provider selection are intentionally explicit:
# there are no defaults for data mode, provider, or model ID. Use personal with
# openai/anthropic only for synthetic content; restricted permits only bedrock.
# Direct provider API keys stay only in the ignored local .env file.
STACKS_DATA_MODE=
STACKS_MODEL_PROVIDER=
STACKS_MODEL_ID=
STACKS_MODEL_MAX_OUTPUT_TOKENS=2048
STACKS_MODEL_MAX_ATTEMPTS=5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AWS and Bedrock. All AWS commands use the default credential chain when the
# profile is empty. Bedrock requires a region and an explicitly selected model.
AWS_BEARER_TOKEN_BEDROCK=
STACKS_AWS_PROFILE=
STACKS_AWS_REGION=
STACKS_INGEST_LEASE_DURATION=5m
STACKS_INGEST_ATTEMPT_TIMEOUT=4m
STACKS_EXTRACTION_PROMPT_VERSION=extract-v2
STACKS_ANALYSIS_PROMPT_VERSION=analyze-v1

# Set these to accepted entity IDs before analyze.
STACKS_EMPLOYEE_ENTITY_ID=
STACKS_MANAGER_ENTITY_ID=

# HTTP service defaults.
STACKS_HTTP_HOST=127.0.0.1
STACKS_HTTP_PORT=8080
STACKS_READ_HEADER_TIMEOUT_SECONDS=5
STACKS_LOG_LEVEL=info

# Optional local OTLP export defaults.
STACKS_OTEL_ENABLED=false
STACKS_OTEL_ENDPOINT=127.0.0.1:4317
STACKS_OTEL_INSECURE=true
STACKS_OTEL_METRIC_EXPORT_INTERVAL=10s
STACKS_OTEL_SERVICE_NAME=stacks
STACKS_OTEL_TRACE_SAMPLE_RATIO=1
